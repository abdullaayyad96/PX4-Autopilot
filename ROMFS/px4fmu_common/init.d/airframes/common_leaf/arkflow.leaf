################# ARK Flow #################
param set-default UAVCAN_ENABLE 2 # Auto discovery
param set-default UAVCAN_SUB_FLOW 1 # Enable
param set-default UAVCAN_SUB_IMU 1 # Enable
param set-default UAVCAN_SUB_RNG 1 # Enable

# EKF related
param set-default EKF2_OF_CTRL 1 # Enable
param set-default UAVCAN_RNG_MAX 30 # in m
param set-default UAVCAN_RNG_MIN 0.08 # in m
param set-default EKF2_RNG_A_HMAX 10
param set-default EKF2_RNG_QLTY_T 0.2
param set-default EKF2_HGT_REF 2 # range sensor
param set-default SENS_FLOW_MINHGT 0.08 # in m
param set-default SENS_FLOW_MAXHGT 25 # in m
param set-default SENS_FLOW_MAXR 7.4 # to match the PAW3902 maximum angular flow rate
